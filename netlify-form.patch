+/* Formulário de contato */
+.kai-form {
+  max-width: 40rem;
+  margin: 2.4rem auto 0;
+  padding-top: 2rem;
+  border-top: 1px solid var(--kai-line);
+}
+
+.kai-form-title {
+  text-align: center;
+  font-weight: 700;
+  color: var(--kai-white);
+  margin-bottom: 1.4rem;
+}
+
+.kai-label {
+  display: block;
+  margin-bottom: 0.35rem;
+  font-size: 0.85rem;
+  font-weight: 600;
+  color: var(--kai-ink-soft);
+}
+
+.kai-input {
+  width: 100%;
+  padding: 0.7rem 0.9rem;
+  background: var(--kai-paper);
+  color: var(--kai-ink);
+  border: 1px solid var(--kai-line);
+  border-radius: 0.6rem;
+  font: inherit;
+  transition: border-color 0.2s ease, box-shadow 0.2s ease;
+}
+
+.kai-input:focus {
+  outline: none;
+  border-color: var(--kai-teal);
+  box-shadow: 0 0 0 3px rgba(0, 229, 255, 0.25);
+}
+
+.kai-form-submit:disabled {
+  opacity: 0.6;
+  cursor: not-allowed;
+}
+
+.kai-form-status {
+  font-size: 0.92rem;
+}
+
+.kai-form-status[data-state='success'] {
+  color: var(--kai-gold);
+}
+
+.kai-form-status[data-state='error'] {
+  color: #ff8a8a;
+}
+
 .footer-tagline {
   font-size: 0.85rem;
 }
